<Application x:Class="QuizApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:QuizApp.Views"
             xmlns:utils="clr-namespace:QuizApp.utils"
             xmlns:vm="clr-namespace:QuizApp.GUI.ViewModels"
             xmlns:utils1="clr-namespace:QuizApp.GUI.utils">
    <Application.Resources>
        <utils:StringEqualityConverter x:Key="StringEqualityConverter" />
        <utils1:InverseBoolConverter x:Key="InverseBoolConverter" />
        <utils:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <Style x:Key="QuizRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Background" Value="#FF2A2A5A" />
            <Setter Property="Margin" Value="0,5,0,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="6">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="PART_Ellipse" Width="16" Height="16" Stroke="White"
                                         StrokeThickness="2" Margin="0,0,8,0" Opacity="0">
                                    <Ellipse.Fill>
                                        <SolidColorBrush Color="White" />
                                    </Ellipse.Fill>
                                </Ellipse>
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="PART_Ellipse" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="PART_Ellipse" Property="Opacity" Value="0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate DataType="{x:Type vm:MultipleChoiceQuestionViewModel}">
            <views:MultipleChoiceQuestionView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:TrueFalseQuestionViewModel}">
            <views:TrueFalseQuestionView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:OpenQuestionViewModel}">
            <views:OpenQuestionView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SortQuestionViewModel}">
            <views:SortQuestionView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:EstimateQuestionViewModel}">
            <views:EstimateQuestionView />
        </DataTemplate>
    </Application.Resources>
</Application>