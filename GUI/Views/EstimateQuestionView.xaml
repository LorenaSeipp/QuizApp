<UserControl x:Class="QuizApp.Views.EstimateQuestionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800" Background="#FF1A1A40" Foreground="White">
    <Grid>
        <Border CornerRadius="15" Background="#FF1A1A40" Padding="30" Width="500" HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel>
                <!-- Frage anzeigen -->
                <TextBlock Text="{Binding QuestionText}"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="White"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,0,0,20" />

                <!-- Eingabefeld für Zahl -->
                <TextBlock Text="Deine Schätzung:"
                           FontSize="16"
                           Foreground="White"
                           Margin="0,0,0,5" />

                <TextBox Text="{Binding UserAnswer, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="18"
                         Padding="5"
                         PreviewTextInput="NumberOnlyInput"
                         HorizontalAlignment="Stretch"
                         Margin="0,0,0,20" />

                <!-- Antwort-Button -->
                <Button Content="Antworten"
                        Command="{Binding SubmitAnswerCommand}"
                        Margin="0,20,0,0"
                        Padding="12"
                        Background="#009688"
                        Foreground="White"
                        FontWeight="Bold" />
                <TextBlock Text="{Binding RemainingSeconds, StringFormat='Restzeit: {0} Sekunden'}"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="Orange"
                           TextAlignment="Right"
                           Margin="0,0,0,20" />
            </StackPanel>
        </Border>
        <Border Background="#AA000000"
                Visibility="{Binding IsFeedbackVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="White" Padding="20" CornerRadius="10"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding EarnedPoints, StringFormat='Erhaltene Punkte: +{0}'}"
                               FontSize="16"
                               Foreground="#009688"
                               TextAlignment="Center"
                               Margin="0,10,0,0" />

                    <TextBlock Text="{Binding TotalPoints, StringFormat='Gesamtpunktzahl: {0}'}"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="Orange"
                               TextAlignment="Center"
                               Margin="0,5,0,20" />
                    <TextBlock Text="{Binding FeedbackMessage}" Foreground="Black" FontSize="20" FontWeight="Bold"
                               TextAlignment="Center" />
                    <TextBlock Text="Zeit abgelaufen!" FontSize="16" Foreground="Red" TextAlignment="Center"
                               Visibility="{Binding WasTimeUp, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>