<UserControl x:Class="QuizApp.Views.MultipleChoiceQuestionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FF1A1A40">
    <Grid>
        <Border CornerRadius="15"
                Background="#FF1A1A40"
                Padding="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch">
                <!-- Frage -->
                <TextBlock Text="{Binding QuestionText}"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="White"
                           TextWrapping="Wrap"
                           TextAlignment="Center" />

                <!-- Antworten -->
                <StackPanel>
                    <RadioButton Content="{Binding Answers[0]}" GroupName="Answers"
                                 FontSize="18" Padding="10"
                                 Style="{StaticResource QuizRadioButtonStyle}" />
                    <RadioButton Content="{Binding Answers[1]}" GroupName="Answers"
                                 FontSize="18" Padding="10"
                                 Style="{StaticResource QuizRadioButtonStyle}" />
                    <RadioButton Content="{Binding Answers[2]}" GroupName="Answers"
                                 FontSize="18" Padding="10"
                                 Style="{StaticResource QuizRadioButtonStyle}" />
                    <RadioButton Content="{Binding Answers[3]}" GroupName="Answers"
                                 FontSize="18" Padding="10"
                                 Style="{StaticResource QuizRadioButtonStyle}" />
                </StackPanel>

                <!-- Submit Button -->
                <Button Content="Antworten"
                        Command="{Binding SubmitAnswerCommand}"
                        Background="#009688"
                        Foreground="White"
                        FontWeight="Bold"
                        Padding="12"
                        Margin="0,20,0,0"
                        Cursor="Hand"
                        BorderThickness="0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>