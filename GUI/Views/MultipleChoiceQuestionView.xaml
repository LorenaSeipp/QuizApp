<UserControl x:Class="QuizApp.Views.MultipleChoiceQuestionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FF1A1A40">

    <Grid>
        <StackPanel Margin="30" VerticalAlignment="Center">
            <!-- Frage -->
            <TextBlock Text="{Binding QuestionText}"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="White"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,0,0,20" />

            <!-- Antworten -->
            <ItemsControl ItemsSource="{Binding Answers}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <RadioButton Content="{Binding}"
                                     GroupName="AnswersGroup"
                                     FontSize="18"
                                     Foreground="White"
                                     Tag="{Binding}"
                                     Margin="0,5"
                                     Checked="RadioButton_Checked" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Button -->
            <Button Content="Antworten"
                    Command="{Binding SubmitAnswerCommand}"
                    Margin="0,20,0,0"
                    Padding="12"
                    Background="#009688"
                    Foreground="White"
                    FontWeight="Bold" />
        </StackPanel>
    </Grid>
</UserControl>