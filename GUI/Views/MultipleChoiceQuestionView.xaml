<UserControl x:Class="QuizApp.Views.MultipleChoiceQuestionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="1024" d:DesignWidth="1920"
             Background="#FF1A1A40" Foreground="White">

    <Grid>
        <StackPanel Margin="20" VerticalAlignment="Center" HorizontalAlignment="Center">
            <!-- Frage -->
            <TextBlock Text="{Binding QuestionText}"
                       FontWeight="Bold"
                       FontSize="60"
                       Foreground="White"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,0,0,20" />

            <!-- Antworten -->
            <ItemsControl ItemsSource="{Binding Answers}" HorizontalAlignment="Center">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#292955"
                                CornerRadius="12"
                                Margin="0,10"
                                Padding="20"
                                Width="600"
                                Cursor="Hand">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <RadioButton GroupName="AnswersGroup"
                                             Tag="{Binding}"
                                             Checked="RadioButton_Checked"
                                             VerticalAlignment="Center"
                                             Margin="0,10,20,0" />

                                <TextBlock Grid.Column="1"
                                           Text="{Binding}"
                                           FontSize="32"
                                           VerticalAlignment="Center"
                                           Foreground="White"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>


            <!-- Button -->
            <Button Content="Antworten"
                    Command="{Binding SubmitAnswerCommand}"
                    Margin="0,20,0,0"
                    Padding="12"
                    Background="#009688"
                    Foreground="White"
                    FontWeight="Bold"
                    Width="400" />
            <TextBlock Text="{Binding RemainingSeconds, StringFormat='Restzeit: {0} Sekunden'}"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="Orange"
                       TextAlignment="Right"
                       Margin="0,0,0,20" />
        </StackPanel>

        <Border Background="#AA000000"
                Visibility="{Binding IsFeedbackVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="White" Padding="20" CornerRadius="10"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding EarnedPoints, StringFormat='Erhaltene Punkte: +{0}'}"
                               FontSize="30"
                               Foreground="#009688"
                               TextAlignment="Center"
                               Margin="0,10,0,0" />

                    <TextBlock Text="{Binding TotalPoints, StringFormat='Gesamtpunktzahl: {0}'}"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="Orange"
                               TextAlignment="Center"
                               Margin="0,5,0,20" />
                    <TextBlock Text="{Binding FeedbackMessage}" Foreground="Black" FontSize="30" FontWeight="Bold"
                               TextAlignment="Center" />
                    <TextBlock Text="Zeit abgelaufen!" FontSize="30" Foreground="Red" TextAlignment="Center"
                               Visibility="{Binding WasTimeUp, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>