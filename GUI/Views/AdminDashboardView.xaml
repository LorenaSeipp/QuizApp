<UserControl x:Class="QuizApp.Views.AdminDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FF1A1A40" Foreground="White">


    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Vertical" Grid.Row="0" Grid.Column="0" Margin="0,0,0,20">
            <TextBlock Text="Frage hinzufügen" FontSize="20" FontWeight="Bold" Margin="0,0,0,10" />

            <TextBlock Text="Kategorie:" />
            <ComboBox Width="100" Margin="0,0,0,10"
                      SelectedValue="{Binding Category, UpdateSourceTrigger=PropertyChanged}"
                      SelectedValuePath="Content">
                <ComboBoxItem Content="Musik" />
                <ComboBoxItem Content="Geografie" />
                <ComboBoxItem Content="Informatik" />
                <ComboBoxItem Content="Fun-Facts" />
            </ComboBox>

            <TextBlock Text="Schwierigkeitsgrad:" />
            <ComboBox Width="100" Margin="0,0,0,0"
                      SelectedValue="{Binding DifficultyString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                <ComboBoxItem Content="leicht" />
                <ComboBoxItem Content="mittel" />
                <ComboBoxItem Content="schwer" />
            </ComboBox>

            <!-- Frage-Typ Auswahl -->
            <TextBlock Text="Fragetyp:" />
            <ComboBox Width="200" Margin="0,0,0,10"
                      SelectedValue="{Binding SelectedQuestionType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      SelectedValuePath="Content">
                <ComboBoxItem Content="MultipleChoice" />
                <ComboBoxItem Content="Estimate" />
                <ComboBoxItem Content="TrueFalse" />
                <ComboBoxItem Content="Sort" />
                <ComboBoxItem Content="Open" />
            </ComboBox>

            <TextBlock Text="Frage:" />
            <TextBox Width="400" Margin="0,0,0,10"
                     Text="{Binding QuestionText, UpdateSourceTrigger=PropertyChanged}" />

            <!-- Multiple Choice Antworten -->
            <StackPanel Visibility="{Binding IsMultipleChoiceVisible, Converter={StaticResource BoolToVis}}"
                        Margin="0,5,0,0">
                <TextBlock Text="Richtige Antwort:" />
                <TextBox Width="400" Margin="0,0,0,5"
                         Text="{Binding RightAnswer, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Falsche Antworten:" />
                <TextBox Width="400" Margin="0,0,0,3"
                         Text="{Binding FalseAnswer1, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Width="400" Margin="0,0,0,3"
                         Text="{Binding FalseAnswer2, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Width="400" Margin="0,0,0,3"
                         Text="{Binding FalseAnswer3, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <!-- Estimate Antwort -->
            <StackPanel Visibility="{Binding IsEstimateVisible, Converter={StaticResource BoolToVis}}" Margin="0,5,0,0">
                <TextBlock Text="Richtige Schätzung:" />
                <TextBox Width="400" Margin="0,0,0,5"
                         Text="{Binding RightAnswer, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <!-- TrueFalse Antwort -->
            <StackPanel Visibility="{Binding IsTrueFalseVisible, Converter={StaticResource BoolToVis}}"
                        Margin="0,5,0,0">
                <TextBlock Text="Ist die Aussage wahr?" />
                <ComboBox Width="100"
                          SelectedValue="{Binding TrueFalseString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          SelectedValuePath="Content">
                    <ComboBoxItem Content="Wahr" />
                    <ComboBoxItem Content="Falsch" />
                </ComboBox>

            </StackPanel>

            <!-- Sort Antwort -->
            <StackPanel Visibility="{Binding IsSortVisible, Converter={StaticResource BoolToVis}}" Margin="0,5,0,0">
                <TextBlock Text="Platz 1:" />
                <TextBox Width="400" Margin="0,0,0,5"
                         Text="{Binding SortPlace1, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Platz 2:" />
                <TextBox Width="400" Margin="0,0,0,5"
                         Text="{Binding SortPlace2, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Platz 3:" />
                <TextBox Width="400" Margin="0,0,0,5"
                         Text="{Binding SortPlace3, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Platz 4:" />
                <TextBox Width="400" Margin="0,0,0,5"
                         Text="{Binding SortPlace4, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <!-- Open Antwort -->
            <StackPanel Visibility="{Binding IsOpenVisible, Converter={StaticResource BoolToVis}}" Margin="0,5,0,0">
                <TextBlock Text="Antwort:" />
                <TextBox Width="400" Margin="0,0,0,3"
                         Text="{Binding OpenAnswer, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <Button Content="Frage speichern" Width="150" Margin="0,10,0,0" Command="{Binding SaveQuestionCommand}"
                    Foreground="White" Background="#009688" />
        </StackPanel>
    </Grid>

</UserControl>