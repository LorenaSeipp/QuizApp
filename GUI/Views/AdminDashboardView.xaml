<Window x:Class="QuizApp.Views.AdminDashboardView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Admin Dashboard" Height="600" Width="700"
        Background="#FF2A2A2A" Foreground="White">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Vertical" Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Frage hinzufügen" FontSize="20" FontWeight="Bold" Margin="0,0,0,10" />

            <TextBlock Text="Kategorie:" />
            <TextBox x:Name="CategoryTextBox" Width="200" Margin="0,0,0,10" />

            <TextBlock Text="Schwierigkeitsgrad (0=leicht,1=mittel,2=schwer):" />
            <ComboBox x:Name="DifficultyComboBox" Width="100" Margin="0,0,0,10">
                <ComboBoxItem Content="0" />
                <ComboBoxItem Content="1" />
                <ComboBoxItem Content="2" />
            </ComboBox>

            <TextBlock Text="Fragetyp:" />
            <ComboBox x:Name="QuestionTypeComboBox" Width="200"
                      SelectionChanged="QuestionTypeComboBox_SelectionChanged" Margin="0,0,0,10">
                <ComboBoxItem Content="MultipleChoice" />
                <ComboBoxItem Content="Estimate" />
                <ComboBoxItem Content="TrueFalse" />
                <ComboBoxItem Content="Sort" />
                <ComboBoxItem Content="Open" />
            </ComboBox>

            <TextBlock Text="Frage:" />
            <TextBox x:Name="QuestionTextBox" Width="400" Margin="0,0,0,10" />

            <!-- Multiple Choice Antworten -->
            <StackPanel x:Name="MultipleChoicePanel" Visibility="Collapsed" Margin="0,5,0,0">
                <TextBlock Text="Richtige Antwort:" />
                <TextBox x:Name="RightAnswerTextBox" Width="400" Margin="0,0,0,5" />
                <TextBlock Text="Falsche Antworten:" />
                <TextBox x:Name="FalseAnswer1TextBox" Width="400" Margin="0,0,0,3" />
                <TextBox x:Name="FalseAnswer2TextBox" Width="400" Margin="0,0,0,3" />
                <TextBox x:Name="FalseAnswer3TextBox" Width="400" Margin="0,0,0,3" />
            </StackPanel>

            <!-- Estimate Antwort -->
            <StackPanel x:Name="EstimatePanel" Visibility="Collapsed" Margin="0,5,0,0">
                <TextBlock Text="Richtige Schätzung:" />
                <TextBox x:Name="EstimateAnswerTextBox" Width="400" Margin="0,0,0,5" />
            </StackPanel>

            <!-- TrueFalse Antwort -->
            <StackPanel x:Name="TrueFalsePanel" Visibility="Collapsed" Margin="0,5,0,0">
                <TextBlock Text="Ist die Aussage wahr?" />
                <ComboBox x:Name="TrueFalseComboBox" Width="100">
                    <ComboBoxItem Content="Wahr" Tag="1" />
                    <ComboBoxItem Content="Falsch" Tag="0" />
                </ComboBox>
            </StackPanel>

            <!-- Sort Antwort -->
            <StackPanel x:Name="SortPanel" Visibility="Collapsed" Margin="0,5,0,0">
                <TextBlock Text="Richtige Reihenfolge:" Margin="0,0,0,5" />
                <TextBlock Text="Platz 1:" />
                <TextBox x:Name="Place1TextBox" Width="400" Margin="0,0,0,5" />
                <TextBlock Text="Platz 2:" />
                <TextBox x:Name="Place2TextBox" Width="400" Margin="0,0,0,5" />
                <TextBlock Text="Platz 3:" />
                <TextBox x:Name="Place3TextBox" Width="400" Margin="0,0,0,5" />
                <TextBlock Text="Platz 4:" />
                <TextBox x:Name="Place4TextBox" Width="400" Margin="0,0,0,5" />
            </StackPanel>

            <!-- Open Antwort -->
            <StackPanel x:Name="OpenPanel" Visibility="Collapsed" Margin="0,5,0,0">
                <TextBlock Text="Antwort:" />
                <TextBox x:Name="OpenAnswerTextBox" Width="400" Margin="0,0,0,3" />
            </StackPanel>

            <Button Content="Frage speichern" Width="150" Margin="0,10,0,0" Click="SaveQuestion_Click"
                    Background="LightGreen" />
        </StackPanel>
    </Grid>
</Window>