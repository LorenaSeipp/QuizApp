<UserControl x:Class="QuizApp.Views.HighscoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FF1A1A40">
    <Grid>
        <Border CornerRadius="15" Background="#FF1A1A40" Padding="30" Width="400" HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel>
               
                <TextBlock Text="Punktzahl"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="White"
                           TextAlignment="Center"
                           Margin="0,0,0,20" />

               
                <Border Background="#25275E" CornerRadius="10" Padding="15" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="{Binding CurrentPlayerName}" 
                                   FontSize="22" 
                                   FontWeight="SemiBold" 
                                   Foreground="White" />
                        <TextBlock Text="{Binding CurrentPlayerScore, StringFormat=Score: {0}}" 
                                   FontSize="18" 
                                   Foreground="LightGray" />
                    </StackPanel>
                </Border>

                
                <TextBlock Text="Top 5 Highscores"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,0,0,10" />

                <!-- Liste der Top 5 -->
                <ItemsControl ItemsSource="{Binding TopHighscores}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#25275E" CornerRadius="10" Padding="10" Margin="0,5,0,5">
                                <DockPanel>
                                    <TextBlock Text="{Binding Name}" 
                                               FontSize="18" 
                                               Foreground="White" 
                                               DockPanel.Dock="Left" />
                                    <TextBlock Text="{Binding Highscore}" 
                                               FontSize="18" 
                                               Foreground="LightGray" 
                                               HorizontalAlignment="Right"
                                               DockPanel.Dock="Right" />
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

