<UserControl x:Class="QuizApp.Views.UserLoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="1024" d:DesignWidth="1920"
             Background="#FF1A1A40" Foreground="White">

    <Grid>
        <Border CornerRadius="15" Background="#FF1A1A40" Padding="30" Width="900" HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="User Login"
                           FontSize="150"
                           FontWeight="Bold"
                           Foreground="White"
                           TextAlignment="Center"
                           Margin="0,0,0,20" />

                <TextBlock Text="Benutzername" Foreground="White" Margin="0,0,0,5" />
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Padding="5" />

                <TextBlock Text="Passwort" Foreground="White" Margin="0,10,0,5" />
                <PasswordBox x:Name="PasswordBox" Padding="5" PasswordChanged="PasswordBox_PasswordChanged" />

                <Button Content="Login"
                        Command="{Binding LoginCommand}"
                        Background="#009688"
                        Foreground="White"
                        Padding="10"
                        Margin="0,20,0,0"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand" />

                <Button Content="Registrieren"
                        Command="{Binding RegisterPlayerCommand}"
                        Background="#03A9F4"
                        Foreground="White"
                        Padding="10"
                        Margin="0,10,0,0"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>