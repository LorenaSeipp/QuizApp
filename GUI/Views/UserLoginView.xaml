<UserControl x:Class="QuizApp.Views.UserLoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FF1A1A40">
    <Grid>
        <Border CornerRadius="15" Background="White" Padding="30" Width="400" HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="QuizApp Login"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#1A1A40"
                           TextAlignment="Center"
                           Margin="0,0,0,20" />

                <TextBlock Text="Benutzername" Foreground="#1A1A40" Margin="0,0,0,5" />
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" FontSize="16" Padding="5" />

                <TextBlock Text="Passwort" Foreground="#1A1A40" Margin="15,10,0,5" />
                <PasswordBox x:Name="PasswordBox" FontSize="16" Padding="5"
                             PasswordChanged="PasswordBox_PasswordChanged" />

                <Button Content="Login"
                        Command="{Binding LoginCommand}"
                        Background="#009688"
                        Foreground="White"
                        Padding="10"
                        Margin="0,20,0,0"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand" />

                <Button Content="Neu registrieren"
                        Command="{Binding RegisterPlayerCommand}"
                        Background="#03A9F4"
                        Foreground="White"
                        Padding="10"
                        Margin="0,10,0,0"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>