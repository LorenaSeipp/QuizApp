<UserControl x:Class="Meilenstein03.Views.SettingsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Meilenstein03.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800" Background="#FF864545">
    <Grid>
        <TextBlock Text="SETTINGS"/>
        <Button Command="{Binding NavigateQuizCommand}" 
            Content="start quiz" 
                HorizontalAlignment="Left" 
                Margin="386,180,0,0"
                VerticalAlignment="Top" 
                Click="Button_Click"/>
        <StackPanel VerticalAlignment="Bottom">
            <RadioButton Content="gemischt"/>
            <RadioButton Content="custom"/>
        </StackPanel>
    </Grid>
</UserControl>
