<UserControl x:Class="QuizApp.Views.EndScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="1024" d:DesignWidth="1920"
             Background="#FF1A1A40" Foreground="White">

    <Grid>
        <Border CornerRadius="15"
                Background="#FF1A1A40"
                Padding="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                <TextBlock Text="Quiz beendet!"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="White"
                           TextAlignment="Center"
                           Margin="0,0,0,10" />

                <TextBlock Text="{Binding FinalScore, StringFormat='Gesamtpunktzahl: {0}'}"
                           FontSize="32"
                           FontWeight="SemiBold"
                           Foreground="White"
                           TextAlignment="Center" />

            </StackPanel>
        </Border>
    </Grid>
</UserControl>