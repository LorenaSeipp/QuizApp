<UserControl x:Class="QuizApp.Views.EndScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FF1A1A40">

    <Grid>
        <Border CornerRadius="15"
                Background="#FF1A1A40"
                Padding="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                
                <TextBlock Text="Quiz beendet!"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="White"
                           TextAlignment="Center"
                           Margin="0,0,0,10"/>

                <TextBlock Text="{Binding FinalScore, StringFormat='Gesamtpunktzahl: {0}'}"
                           FontSize="32"
                           FontWeight="SemiBold"
                           Foreground="White"
                           TextAlignment="Center"/>
                
            </StackPanel>
        </Border>
    </Grid>
</UserControl>