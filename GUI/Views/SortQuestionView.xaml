<UserControl x:Class="QuizApp.Views.SortQuestionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FF1A1A40">
    <Grid>
        <Border CornerRadius="15"
                Background="#FF1A1A40"
                Padding="40"
                MaxHeight="800"
                MaxWidth="1200"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch">
                
                <!-- Frage -->
                <TextBlock Text="{Binding QuestionText}"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="White"
                           TextWrapping="Wrap"
                           TextAlignment="Center" />

                <!-- Sortierbare Antworten -->
                <ItemsControl ItemsSource="{Binding SortItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                <TextBlock Text="{Binding Text}"
                                           FontSize="18"
                                           Foreground="White"
                                           Width="300"
                                           VerticalAlignment="Center" />
                                <Button Content="↑"
                                        Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Margin="10,0"
                                        Width="30"/>
                                <Button Content="↓"
                                        Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Width="30"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Submit Button -->
                <Button Content="Antwort einreichen"
                        Command="{Binding SubmitAnswerCommand}"
                        Background="#009688"
                        Foreground="White"
                        FontWeight="Bold"
                        Padding="12"
                        Margin="0,20,0,0"
                        Cursor="Hand"
                        BorderThickness="0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
