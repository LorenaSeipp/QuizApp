<UserControl x:Class="QuizApp.Views.SortQuestionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FF1A1A40" Foreground="White"
             MinHeight="300" MinWidth="400">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Frage -->
        <TextBlock Text="{Binding QuestionText}"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,15" />

        <!-- Sortierbare Liste -->
        <ListBox x:Name="SortListBox"
                 ItemsSource="{Binding UserSortOrder}"
                 SelectedIndex="0"
                 Grid.Row="1"
                 Background="#FF2A2A5A"
                 BorderBrush="Gray"
                 BorderThickness="1"
                 FontSize="16"
                 Margin="0,0,0,15" />

        <!-- Buttons zum Sortieren -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Grid.Row="2">
            <Button Content="↑ Nach oben" Width="100" Click="MoveUp_Click" />
            <Button Content="↓ Nach unten" Width="100" Click="MoveDown_Click" />

            <!-- Submit Button -->
            <Button Content="Antworten"
                    Command="{Binding SubmitAnswerCommand}"
                    Background="#009688"
                    Foreground="White"
                    FontWeight="Bold"
                    Padding="12"
                    Margin="0,20,0,0"
                    Cursor="Hand"
                    BorderThickness="0" />
        </StackPanel>
    </Grid>
</UserControl>