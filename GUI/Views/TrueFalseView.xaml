<UserControl x:Class="QuizApp.Views.TrueFalseQuestionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FF1A1A40" Foreground="White">
    <StackPanel Margin="20">
        <TextBlock Text="{Binding QuestionText}" FontSize="18" TextWrapping="Wrap" Margin="0,0,0,20" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
            <RadioButton Content="True" IsChecked="{Binding UserAnswer, Mode=TwoWay}" GroupName="TrueFalseGroup"
                         Tag="True" Margin="0,0,10,0" Foreground="White" />
            <RadioButton Content="False"
                         IsChecked="{Binding UserAnswer, Converter={StaticResource InverseBoolConverter}, Mode=TwoWay}"
                         GroupName="TrueFalseGroup" Tag="False" Foreground="White"/>

            <!-- Submit Button -->
            <Button Content="Antworten"
                    Command="{Binding SubmitAnswerCommand}"
                    Background="#009688"
                    Foreground="White"
                    FontWeight="Bold"
                    Padding="12"
                    Margin="0,20,0,0"
                    Cursor="Hand"
                    BorderThickness="0" />
        </StackPanel>
    </StackPanel>
</UserControl>